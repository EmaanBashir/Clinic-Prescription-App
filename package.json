{
  "name": "prescription-app",
  "version": "1.0.0",
  "description": "Offline Doctor Prescription Management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "*",
    "electron-builder": "*"
  },
  "dependencies": {
    "better-sqlite3": "*",
    "xlsx": "*"
  },
  "build": {
    "appId": "com.prescription.doctorapp",
    "productName": "Prescription Manager",
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
